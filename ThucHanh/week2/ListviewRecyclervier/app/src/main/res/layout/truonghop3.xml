<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TruongHop2"
    tools:ignore="ExtraText">


    <RelativeLayout
        android:id="@+id/div_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="150dp"
        tools:layout_editor_absoluteY="0dp">

        <TextView
            android:id="@+id/header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quản lý nhân viên"
            tools:ignore="MissingConstraints"
            android:gravity="center"
            android:textColor="@color/white"
            android:background="@color/green"
            />

        <RelativeLayout
            android:id="@+id/box_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/header_title">

            <TextView
                android:id="@+id/nv_id"
                android:layout_width="150px"
                android:layout_height="wrap_content"

                android:layout_alignTop="@id/id_input"
                android:layout_alignBottom="@id/id_input"
                android:gravity="center_vertical"
                android:text="Mã NV"
                tools:ignore="MissingConstraints" />

            <EditText
                android:id="@+id/id_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/nv_id"
                android:inputType="text"
                tools:ignore="MissingConstraints" />

            <TextView
                android:id="@+id/nv_name"
                android:layout_width="150px"
                android:layout_height="wrap_content"
                android:layout_below="@id/id_input"
                android:layout_alignTop="@id/name_input"
                android:layout_alignBottom="@id/name_input"
                android:gravity="center_vertical"
                android:text="Tên NV"
                tools:ignore="MissingConstraints" />

            <EditText
                android:id="@+id/name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/id_input"
                android:layout_toEndOf="@id/nv_name"
                android:inputType="text"
                tools:ignore="MissingConstraints" />

            <TextView
                android:id="@+id/nv_type"
                android:layout_width="150px"
                android:layout_height="wrap_content"
                android:layout_below="@id/name_input"
                android:layout_alignTop="@id/box_radio"
                android:layout_alignBottom="@id/box_radio"
                android:gravity="center_vertical"
                android:text="Loại NV"
                tools:ignore="MissingConstraints" />

            <RadioGroup
                android:id="@+id/box_radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/name_input"
                android:layout_toEndOf="@id/nv_type"
                android:gravity="center"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_ChinhThuc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chính thức" />

                <RadioButton
                    android:layout_marginLeft="100px"
                    android:id="@+id/radio_ThoiVu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thời vụ" />

            </RadioGroup>

        </RelativeLayout>


        <Button
            android:id="@+id/button_name"
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/box_input"
            android:text="Nhập NV" />
    </RelativeLayout>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/tv_person"
        android:text=""
        android:background="@color/green"
        android:textColor="@color/white"
        android:padding="5px"
        tools:ignore="MissingConstraints"

        app:layout_constraintTop_toBottomOf="@id/div_header"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />

    <ListView
        app:layout_constraintTop_toBottomOf="@id/tv_person"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/lv_person"
        tools:ignore="MissingConstraints" />



</androidx.constraintlayout.widget.ConstraintLayout>