<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TruongHop2"
    tools:ignore="ExtraText">

    <LinearLayout
        android:id="@+id/div_header"
        android:layout_width="412dp"
        android:layout_height="97dp"
        android:orientation="horizontal"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="-1dp"
        tools:layout_editor_absoluteY="0dp">

        <TextView
            android:id="@+id/title_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhập tên"
            tools:ignore="MissingConstraints" />

        <EditText
            android:layout_width="349dp"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints"
            android:id="@+id/input_name"
            android:inputType="text"
            />
    </LinearLayout>

    <Button
        android:id="@+id/button_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhập"
        app:layout_constraintBottom_toBottomOf="@+id/div_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints" />
    />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/tv_person"
        android:text=""
        android:background="@color/blue"
        android:textColor="@color/white"
        android:padding="5px"
        tools:ignore="MissingConstraints"

        app:layout_constraintTop_toBottomOf="@id/div_header"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />

    <ListView
        app:layout_constraintTop_toBottomOf="@id/tv_person"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/lv_person"
        tools:ignore="MissingConstraints" />



</androidx.constraintlayout.widget.ConstraintLayout>